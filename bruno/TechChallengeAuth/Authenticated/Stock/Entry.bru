meta {
  name: Stock Entry
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/item/{{itemId}}/stock/entry
  body: json
  auth: inherit
}

body:json {
  {
    "quantity": 10,
    "reason": "Purchase NF 12345",
    "notes": "Supplier: Auto Parts Ltd"
  }
}

vars:pre-request {
  itemId: a1b2c3d4-e5f6-7890-abcd-ef1234567890
}

settings {
  encodeUrl: true
  timeout: 0
}
