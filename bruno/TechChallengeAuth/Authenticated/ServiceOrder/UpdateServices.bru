meta {
  name: Update Service Order - Services
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/service-order/{{serviceOrderId}}
  body: json
  auth: inherit
}

body:json {
  {
    "services": [
      {
        "service_id": "{{serviceId}}",
        "quantity": 5
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
