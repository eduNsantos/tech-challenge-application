meta {
  name: Update Service Order - Services
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/service-order/{{serviceOrderId}}
  body: json
  auth: inherit
}

vars:pre-request {
  serviceOrderId: 7f4b9068-892f-416d-971a-78872e0a6e0f
  serviceId: 791a20eb-f40c-4ba8-8f02-a6e684abfaf3
}

body:json {
  {
    "services": [
      {
        "service_id": "{{serviceId}}",
        "quantity": 5
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
