meta {
  name: Create Service Order
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/service-order
  body: json
  auth: inherit
}

body:json {
  {
    "vehicle_id": "{{vehicle_id}}",
    "services": [
      {
        "service_id": "{{service_id}}",
        "quantity": 1
      }
    ],
    "parts": [
      {
        "item_id": "{{item_id}}",
        "quantity": 2
      }
    ],
    "send_quote": false
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
