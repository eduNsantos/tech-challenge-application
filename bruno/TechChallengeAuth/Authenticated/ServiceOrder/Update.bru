meta {
  name: Update Service Order
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/service-order/{{serviceOrderId}}
  body: json
  auth: inherit
}

body:json {
  {
    "services": [
      {
        "service_id": "{{serviceId}}",
        "quantity": 3
      }
    ],
    "approve_quote": true
  }
}

vars:pre-request {
  serviceOrderId: 58fcf673-2ed0-46d8-83f8-e6877bf67b76
}

settings {
  encodeUrl: true
  timeout: 0
}
