meta {
  name: Update Service Order
  type: http
  seq: 4
}

put {
  url: {{baseUrl}}/service-order/{{serviceOrderId}}
  body: json
  auth: inherit
}

body:json {
  {
    "services": [
      {
        "service_id": "{{serviceId}}",
        "quantity": 2
      }
    ],
    "approve_quote": true
  }
}

vars:pre-request {
  serviceOrderId: db588983-edb4-43bd-8472-ce40cfee67fd
}

settings {
  encodeUrl: true
  timeout: 0
}
