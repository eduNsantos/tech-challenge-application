meta {
  name: Update Service Order - Items
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/service-order/{{serviceOrderId}}
  body: json
  auth: inherit
}

body:json {
  {
    "items": [
      {
        "item_id": "{{itemId}}",
        "quantity": 5
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
