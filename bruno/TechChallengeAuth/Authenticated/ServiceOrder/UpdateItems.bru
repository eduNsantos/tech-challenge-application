meta {
  name: Update Service Order - Items
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/service-order/{{serviceOrderId}}
  body: json
  auth: inherit
}

vars:pre-request {
  serviceOrderId: 7f4b9068-892f-416d-971a-78872e0a6e0f
  itemId: b6f02d33-73d8-4268-8711-a29d3137bac4
}

body:json {
  {
    "items": [
      {
        "item_id": "{{itemId}}",
        "quantity": 5
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
