meta {
  name: Register
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
    "email": "edu.nascimento22@outlook.com",
    "name": "Eduardo Santos",
    "password": "senha12345",
    "password_confirmation": "senha12345"
  }
}

script:post-response {
  try {
    let body = res.getBody();
    
    bru.setVar('token', body.access_token);
  } catch (e) {
    console.log('Erro ao parsear JSON', e);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
